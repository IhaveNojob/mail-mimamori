# Copy to .env (never commit .env)
# Daytona (deploy only; not copied into the sandbox): https://app.daytona.io -> API Keys
DAYTONA_API_KEY=
DAYTONA_API_URL=https://app.daytona.io/api

# LINE Messaging API (leave empty -> LINE_MODE=fake, use /demo instead)
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=

# Nosana LLM inference (preferred): https://deploy.nosana.com -> Account -> API Keys
NOSANA_API_KEY=
# NOSANA_MODEL=qwen/qwen3.8-27b

# Claude (used if no Nosana key; leave both empty -> ANALYZER=fake, canned results)
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5-5

# Optional
# BATCH_WINDOW_SEC=45
# TRASH_DIGEST_HOUR=19
# REMINDER_HOUR=9
# DEMO_MODE=1   # 0 to disable /demo in real use
